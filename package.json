{
  "name": "nest-seeder-workspace",
  "version": "2.0.0",
  "description": "Monorepo for @ackplus/nest-seeder — a database seeding library for NestJS.",
  "private": true,
  "license": "MIT",
  "author": "AckPlus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ack-solutions/nest-seeder.git"
  },
  "homepage": "https://ack-solutions.github.io/nest-seeder/",
  "scripts": {
    "build:packages": "pnpm -C packages/nest-seeder build",
    "build:example": "pnpm -C apps/example-app build",
    "build": "pnpm build:packages && pnpm build:example",
    "typecheck": "pnpm -C packages/nest-seeder typecheck",
    "test": "pnpm -C packages/nest-seeder test && pnpm -C apps/example-app test",
    "lint": "pnpm -C packages/nest-seeder lint",
    "docs:dev": "pnpm -C docs dev",
    "docs:build": "pnpm -C docs build",
    "docs:preview": "pnpm -C docs preview",
    "release": "node scripts/publish.js"
  },
  "keywords": [
    "nestjs",
    "seeder",
    "database",
    "faker",
    "typeorm",
    "mongoose"
  ],
  "packageManager": "pnpm@10.21.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "esbuild",
      "sqlite3",
      "unrs-resolver"
    ]
  }
}
